{
  "rewrites": [
    { "source": "/site/:tenant/llms.txt", "destination": "/api/llms-txt?tenant=:tenant" },
    { "source": "/site/:tenant/robots.txt", "destination": "/api/robots-txt?tenant=:tenant" },
    { "source": "/site/:tenant/mcp", "destination": "/api/mcp?tenant=:tenant" },
    { "source": "/site/:tenant", "destination": "/api/site?tenant=:tenant" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
