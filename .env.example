# Copy to .env for local dev (`vercel env pull .env` can also generate this).
# Real values live in Vercel project env vars, never committed.
# All of these are server-side only (read by api/*.ts). The browser bundle
# needs no environment variables, so never add a VITE_ prefix to any of them.

# Supabase (lib/db.ts). The service role key bypasses RLS: server only.
SUPABASE_URL=https://ujddmaxacmnerwdyyvao.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (lib/ai/structure.ts, lib/ai/extractClaims.ts, api/monitor.ts).
# Optional. Without it, free-form AI updates and the accuracy check return an
# error; the dashboard's scripted demo updates fall back to preset change sets;
# everything else works.
ANTHROPIC_API_KEY=
